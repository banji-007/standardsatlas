---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FrameworkBar from '../components/FrameworkBar.astro';
import VersionTimelineIsland from '../components/islands/VersionTimelineIsland';
import { getAppData } from '../lib/appData';

const appData = await getAppData();
const active = appData.standards.filter(s => s.status === 'active').length;
const sunset = appData.standards.filter(s => s.status === 'sunset-scheduled' || s.status === 'under-review').length;
const docs = appData.standards.reduce((a, s) => a + s.documents.length, 0);
---

<BaseLayout
  title="Cross-family version timeline"
  description="Verified version releases across every PCI security standard, 2016 to 2028, with scheduled sunsets and retirements."
  canonicalUrl="https://securitystandardsmap.org/timeline"
>
  <FrameworkBar />
  <Hero total={appData.standards.length} active={active} sunset={sunset} docs={docs} lastVerified={appData.lastVerified} />
  <VersionTimelineIsland data={appData} client:load />
</BaseLayout>
