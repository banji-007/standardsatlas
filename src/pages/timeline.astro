---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { statusGlyph, statusLabel } from '../lib/tokens';
import TimelineIsland from '../components/islands/TimelineIsland';
import GraphIsland from '../components/islands/GraphIsland';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import yaml from 'js-yaml';
import type { Relationship, ExternalBody } from '../lib/schema';

const standards = await getCollection('standards');
standards.sort((a, b) => a.data.name.localeCompare(b.data.name));

const relPath = resolve('data/relationships.yaml');
const extPath = resolve('data/external-bodies.yaml');

let relationships: Relationship[] = [];
let externalBodies: ExternalBody[] = [];

try {
  relationships = yaml.load(readFileSync(relPath, 'utf8')) as Relationship[] ?? [];
} catch { /* file may not exist yet */ }

try {
  externalBodies = yaml.load(readFileSync(extPath, 'utf8')) as ExternalBody[] ?? [];
} catch { /* file may not exist yet */ }

const allEvents = standards.flatMap(entry => {
  const s = entry.data;
  return [
    ...s.versions.flatMap(v => [
      v.published ? { id: `${entry.id}-${v.version}-pub`, content: `${s.name} v${v.version}`, start: v.published, group: entry.id, className: `status-${v.status}` } : null,
      v.retired ? { id: `${entry.id}-${v.version}-ret`, content: `${s.name} v${v.version} retired`, start: v.retired, group: entry.id, className: 'status-retired' } : null,
    ]).filter(Boolean),
    ...relationships
      .filter(r => r.effective_date && (r.from === entry.id || r.to === entry.id || (Array.isArray(r.to) && r.to.includes(entry.id))))
      .map(r => ({
        id: `rel-${r.id}`,
        content: r.description ?? `${r.type}: ${r.id}`,
        start: r.effective_date!,
        group: entry.id,
        className: `rel-${r.type}`,
      })),
  ];
});

const timelineGroups = standards.map(entry => ({
  id: entry.id,
  content: entry.data.name,
}));

const graphNodes = [
  ...standards.map(entry => ({
    data: {
      id: entry.id,
      label: entry.data.name,
      status: entry.data.status,
      type: 'standard',
      sourceUrl: entry.data.source_url,
    },
  })),
  ...externalBodies.map(eb => ({
    data: {
      id: eb.slug,
      label: eb.name,
      type: 'external',
      sourceUrl: eb.url ?? '',
    },
  })),
];

const graphEdges = relationships.map(r => ({
  data: {
    id: r.id,
    source: r.from,
    target: Array.isArray(r.to) ? r.to[0] : r.to,
    targets: Array.isArray(r.to) ? r.to : [r.to],
    type: r.type,
    state: r.state,
    description: r.description,
    sourceUrl: r.source_url,
  },
}));

const asOfDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Cross-family timeline"
  description="Cross-family view of PCI security standard versions, sunset dates, and portfolio consolidation — all sourced to official PCI SSC publications."
  canonicalUrl="https://standardsatlas.org/timeline"
>
  <div class="timeline-header">
    <h1>Cross-family timeline</h1>
    <p class="lead">
      All PCI standard versions, retirement events, and inter-standard relationships on one view.
      <span class="as-of">As of {asOfDate}.</span>
    </p>
  </div>

  <section class="section" id="standards-table">
    <h2>Standards overview</h2>
    <table class="data-table">
      <thead>
        <tr>
          <th>Standard</th>
          <th>Status</th>
          <th>Current version</th>
        </tr>
      </thead>
      <tbody>
        {standards.map(entry => (
          <tr>
            <td><a href={`/standard/${entry.id}`}>{entry.data.name}</a></td>
            <td>
              <span class="status-badge" data-status={entry.data.status}>
                {statusGlyph[entry.data.status]} {statusLabel[entry.data.status]}
              </span>
            </td>
            <td class="mono">{entry.data.current_version ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  {allEvents.length > 0 && (
    <section class="section" id="timeline">
      <h2>Timeline</h2>
      <div id="timeline-container" style="height: 500px;">
        <TimelineIsland events={allEvents} groups={timelineGroups} client:visible />
      </div>
    </section>
  )}

  {graphNodes.length > 0 && (
    <section class="section graph-section" id="graph">
      <h2>Relationship graph</h2>
      <p class="graph-note">
        Nodes are standards and external bodies. Edges are sourced relationships — click any edge for its source.
        Documents are not shown globally; expand per-standard on the
        <a href="/">standards list</a>.
      </p>
      <div id="graph-container" style="height: 500px; border: 1px solid var(--color-border); border-radius: var(--radius);">
        <GraphIsland nodes={graphNodes} edges={graphEdges} client:visible />
      </div>
    </section>
  )}

  <button class="graph-toggle" onclick="document.querySelector('.graph-section').style.display = 'block'; this.style.display = 'none';">
    Show relationship graph
  </button>
</BaseLayout>

<style>
  .timeline-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 48rem;
  }

  .as-of {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .graph-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .graph-toggle {
    display: none;
    margin-top: var(--space-8);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    color: var(--color-accent);
    font-size: 0.9375rem;
  }
</style>
