---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../../lib/tokens';
import TimelineIsland from '../../components/islands/TimelineIsland';

interface Props {
  entry: CollectionEntry<'standards'>;
}

export async function getStaticPaths() {
  const standards = await getCollection('standards');
  return standards.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data: standard } = entry;

const hasProvisional =
  !standard.verified ||
  standard.versions.some(v => !v.verified) ||
  standard.documents.some(d => !d.verified);

const hasVersionRefs = standard.documents.some(d => d.applies_to_version);

function formatDate(d: Date | null): string {
  if (!d) return '—';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const timelineEvents = [
  ...standard.versions.flatMap(v => [
    v.published ? { id: `${entry.id}-${v.version}-pub`, content: `v${v.version} published`, start: v.published, group: standard.name, className: `status-${v.status}` } : null,
    v.retired ? { id: `${entry.id}-${v.version}-ret`, content: `v${v.version} retired`, start: v.retired, group: standard.name, className: 'status-retired' } : null,
  ]).filter(Boolean),
  ...standard.documents.flatMap(d =>
    d.published ? [{ id: `doc-${d.slug}`, content: d.title, start: d.published, group: `${standard.name}: Documents`, className: `doc-${d.type}` }] : []
  ),
];
---

<BaseLayout
  title={standard.name}
  description={`${standard.name}: status, version history, supporting documents, and sunset dates. Security Standards Map.`}
  canonicalUrl={`https://securitystandardsmap.org/standard/${entry.id}`}
  ogType="article"
>
  {hasProvisional && (
    <div class="provisional-notice" role="note">
      <span>Some data on this page has not yet been manually verified against official sources. Fields marked "provisional" should be confirmed before citing.</span>
    </div>
  )}

  <div class="standard-header">
    <div class="header-main">
      <h1>{standard.name}</h1>
      <span class="status-badge" data-status={standard.status}>
        {statusLabel[standard.status]}
      </span>
    </div>
    <div class="header-meta">
      {standard.current_version && (
        <span class="meta-item">
          Current version:
          <span class="mono">{standard.current_version}</span>
        </span>
      )}
      <span class="meta-item">
        Source:
        <a href={standard.source_url} class="source-link" rel="noopener noreferrer" target="_blank">
          pcisecuritystandards.org ↗
        </a>
      </span>
      {standard.last_verified && (
        <span class="meta-item verified-date">
          Verified:
          <time datetime={standard.last_verified.toISOString()}>{formatDate(standard.last_verified)}</time>
        </span>
      )}
    </div>
    {standard.notes && <p class="standard-notes">{standard.notes}</p>}
  </div>

  {standard.versions.length > 0 && (
    <section class="section" id="versions">
      <h2>Version history</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Version</th>
            <th>Status</th>
            <th>Published</th>
            <th>Retired</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {standard.versions.map(v => (
            <tr>
              <td class="mono">{v.version}</td>
              <td>
                <span class="status-badge" data-status={v.status}>
                  {statusLabel[v.status]}
                </span>
              </td>
              <td>{formatDate(v.published)}</td>
              <td>{formatDate(v.retired)}</td>
              <td>
                {v.source_url
                  ? <a href={v.source_url} class="source-link" rel="noopener noreferrer" target="_blank">pcisecuritystandards.org ↗</a>
                  : <span class="no-source">&ndash;</span>}
                {!v.verified && <span class="unverified">provisional</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {standard.documents.length > 0 && (
    <section class="section" id="documents">
      <h2>Supporting documents</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Published</th>
            {hasVersionRefs && <th>Applies to</th>}
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {standard.documents.map(doc => (
            <tr>
              <td>{doc.title}</td>
              <td class="mono">{doc.type}</td>
              <td>{formatDate(doc.published)}</td>
              {hasVersionRefs && <td class="mono">{doc.applies_to_version ?? '—'}</td>}
              <td>
                {doc.source_url
                  ? <a href={doc.source_url} class="source-link" rel="noopener noreferrer" target="_blank">pcisecuritystandards.org ↗</a>
                  : <span class="no-source">&ndash;</span>}
                {!doc.verified && <span class="unverified">provisional</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {timelineEvents.length > 0 && (
    <section class="section" id="timeline">
      <h2>Timeline</h2>
      <div id="timeline-container" style="height: 220px;">
        <TimelineIsland events={timelineEvents} client:visible />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .standard-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .header-main {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .header-main h1 { margin-bottom: 0; }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .meta-item { display: inline-flex; align-items: baseline; gap: 0.3em; }

  .standard-notes {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    max-width: 48rem;
  }

  .verified-date { font-family: var(--font-mono); }

  .no-source { color: var(--color-text-muted); }

  .unverified {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-under-review);
    margin-left: 0.25em;
    padding: 0.1rem 0.3rem;
    border: 1px solid color-mix(in srgb, var(--color-under-review) 30%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-under-review) 8%, transparent);
  }
</style>
