---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FrameworkBar from '../components/FrameworkBar.astro';
import MapIsland from '../components/islands/MapIsland';
import { getAppData } from '../lib/appData';

const appData = await getAppData();
const active = appData.standards.filter(s => s.status === 'active').length;
const sunset = appData.standards.filter(s => s.status === 'sunset-scheduled' || s.status === 'under-review').length;
const docs = appData.standards.reduce((a, s) => a + s.documents.length, 0);
---

<BaseLayout
  title="Transitions"
  description="How PCI security standards supersede, converge into, and align with one another, with version lineage and status for every standard."
  canonicalUrl="https://securitystandardsmap.org/map"
>
  <FrameworkBar />
  <Hero total={appData.standards.length} active={active} sunset={sunset} docs={docs} lastVerified={appData.lastVerified} />
  <MapIsland data={appData} client:load />
</BaseLayout>
