---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import yaml from 'js-yaml';
import type { Standard, Relationship } from '../lib/schema';
import MainIsland from '../components/islands/MainIsland';
import type { AppData } from '../components/islands/MainIsland';
import MobileApp from '../components/islands/MobileApp';
import type { MobileAppData } from '../components/islands/MobileApp';

const standards = await getCollection('standards');

// Load relationships from data file
let relationships: Relationship[] = [];
try {
  const raw = yaml.load(readFileSync(resolve('data/relationships.yaml'), 'utf8')) as { relationships?: Relationship[] } | null;
  relationships = raw?.relationships ?? [];
} catch { /* relationships file may not exist */ }

// Load FAQ Q&A entries and index them by standard slug
interface FaqEntry { number: number; title: string; updated: string | Date; standards: string[]; mapping_method: string; source_url: string; verified: boolean; }
const faqsByStandard: Record<string, FaqEntry[]> = {};
try {
  const rawFaqs = yaml.load(readFileSync(resolve('data/faqs.yaml'), 'utf8')) as { faqs?: FaqEntry[] } | null;
  for (const faq of rawFaqs?.faqs ?? []) {
    for (const slug of faq.standards ?? []) {
      (faqsByStandard[slug] ??= []).push(faq);
    }
  }
} catch { /* faqs file may not exist yet */ }

// Serialize to plain objects (dates → ISO date strings)
const appData: AppData = {
  standards: standards.map(entry => {
    const d = entry.data as Standard;
    const faqDocs = (faqsByStandard[entry.id] ?? []).map(faq => ({
      slug: `faq-${faq.number}`,
      title: faq.title,
      type: 'faq' as const,
      published: faq.updated instanceof Date
        ? faq.updated.toISOString().slice(0, 10)
        : String(faq.updated).slice(0, 10),
      applies_to_version: null,
      source_url: faq.source_url ?? null,
      verified: faq.verified,
    }));
    return {
      slug: entry.id,
      name: d.name,
      status: d.status,
      source_url: d.source_url,
      verified: d.verified,
      last_verified: d.last_verified?.toISOString().slice(0, 10) ?? null,
      current_version: d.current_version ?? null,
      notes: d.notes,
      versions: d.versions.map(v => ({
        version: v.version,
        published: v.published?.toISOString().slice(0, 10) ?? null,
        retired: v.retired?.toISOString().slice(0, 10) ?? null,
        status: v.status,
        source_url: v.source_url ?? null,
        verified: v.verified,
      })),
      documents: [
        ...d.documents.map(doc => ({
          slug: doc.slug,
          title: doc.title,
          type: doc.type,
          published: doc.published?.toISOString().slice(0, 10) ?? null,
          applies_to_version: doc.applies_to_version ?? null,
          source_url: doc.source_url ?? null,
          verified: doc.verified,
        })),
        ...faqDocs,
      ],
    };
  }),
  relationships: relationships.map(r => ({
    id: r.id,
    type: r.type,
    from: r.from,
    to: r.to,
    state: r.state,
    effective_date: r.effective_date?.toISOString().slice(0, 10) ?? null,
    description: r.description ?? null,
    source_url: r.source_url,
    verified: r.verified,
  })),
  lastVerified: standards
    .flatMap(s => (s.data as Standard).last_verified ? [(s.data as Standard).last_verified!] : [])
    .sort((a, b) => b.getTime() - a.getTime())[0]
    ?.toISOString().slice(0, 10) ?? '',
};

// ---- Mobile app data (built independently of appData above, so the
// desktop data path above is never touched by mobile-only changes) ----
let allFaqsRaw: FaqEntry[] = [];
try {
  const rawFaqs = yaml.load(readFileSync(resolve('data/faqs.yaml'), 'utf8')) as { faqs?: FaqEntry[] } | null;
  allFaqsRaw = rawFaqs?.faqs ?? [];
} catch { /* faqs file may not exist yet */ }

const mobileAppData: MobileAppData = {
  standards: standards.map(entry => {
    const d = entry.data as Standard;
    // Match appData above: per-standard FAQs are merged into `documents` as
    // type:'faq' entries, so "documents" counts/groupings stay consistent
    // between the desktop and mobile experiences.
    const faqDocs = (faqsByStandard[entry.id] ?? []).map(faq => ({
      slug: `faq-${faq.number}`,
      title: faq.title,
      type: 'faq' as const,
      published: faq.updated instanceof Date
        ? faq.updated.toISOString().slice(0, 10)
        : String(faq.updated).slice(0, 10),
      applies_to_version: null,
      source_url: faq.source_url ?? null,
      verified: faq.verified,
    }));
    return {
      slug: entry.id,
      name: d.name,
      short: d.short,
      family: d.family,
      status: d.status,
      source_url: d.source_url,
      verified: d.verified,
      last_verified: d.last_verified?.toISOString().slice(0, 10) ?? null,
      current_version: d.current_version ?? null,
      notes: d.notes,
      versions: d.versions.map(v => ({
        version: v.version,
        published: v.published?.toISOString().slice(0, 10) ?? null,
        retired: v.retired?.toISOString().slice(0, 10) ?? null,
        status: v.status,
        source_url: v.source_url ?? null,
        verified: v.verified,
      })),
      documents: [
        ...d.documents.map(doc => ({
          slug: doc.slug,
          title: doc.title,
          type: doc.type,
          published: doc.published?.toISOString().slice(0, 10) ?? null,
          applies_to_version: doc.applies_to_version ?? null,
          source_url: doc.source_url ?? null,
          verified: doc.verified,
        })),
        ...faqDocs,
      ],
    };
  }),
  relationships: relationships.map(r => ({
    id: r.id,
    type: r.type,
    from: r.from,
    to: r.to,
    state: r.state,
    effective_date: r.effective_date?.toISOString().slice(0, 10) ?? null,
    description: r.description ?? null,
    source_url: r.source_url,
    verified: r.verified,
  })),
  // 'excluded' FAQs are out of project scope (see CLAUDE.md scope boundary);
  // 'general' (no standards mapped) becomes the Faqs tab's "General" bucket.
  faqs: allFaqsRaw
    .filter(f => f.mapping_method !== 'excluded')
    .map(f => ({
      number: f.number,
      title: f.title,
      updated: f.updated instanceof Date ? (f.updated as unknown as Date).toISOString().slice(0, 10) : (f.updated ? String(f.updated).slice(0, 10) : null),
      standards: f.standards ?? [],
      mapping_method: f.mapping_method as MobileAppData['faqs'][number]['mapping_method'],
      source_url: f.source_url,
    })),
  lastVerified: appData.lastVerified,
};
---

<BaseLayout
  title="PCI Security Standards Map"
  description="An independent, citeable reference to the PCI security standards landscape: every current standard, its version lineage, status, supporting guidance, and sunset dates."
  fullPage
>
  <div class="desktop-only">
    <MainIsland data={appData} client:load />
  </div>
  <div class="mobile-only">
    <MobileApp data={mobileAppData} client:media="(max-width: 767px)" />
  </div>
</BaseLayout>

<style>
  .desktop-only { display: none; }
  .mobile-only { display: block; }
  @media (min-width: 768px) {
    .desktop-only { display: block; }
    .mobile-only { display: none; }
  }
</style>
