---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../lib/tokens';

const standards: CollectionEntry<'standards'>[] = await getCollection('standards');
standards.sort((a, b) => a.data.name.localeCompare(b.data.name));

const activeCount = standards.filter(s => s.data.status === 'active').length;
const sunsetCount = standards.filter(s => s.data.status === 'sunset-scheduled').length;
const totalDocs = standards.reduce((n, s) => n + s.data.documents.length, 0);
const lastVerified = standards
  .flatMap(s => s.data.last_verified ? [s.data.last_verified] : [])
  .sort((a, b) => b.getTime() - a.getTime())[0];
---

<BaseLayout title="Security Standards Map">
  <!-- Framework filter bar -->
  <div class="framework-bar">
    <span class="framework-label">Framework</span>
    <div class="framework-chips">
      <span class="framework-chip framework-chip--active">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="currentColor">
          <path d="M1.5 5l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        PCI
      </span>
      <span class="framework-chip framework-chip--soon">ISO <span class="soon-badge">soon</span></span>
      <span class="framework-chip framework-chip--soon">NIST <span class="soon-badge">soon</span></span>
      <span class="framework-chip framework-chip--soon">EMV <span class="soon-badge">soon</span></span>
    </div>
  </div>

  <!-- Hero -->
  <div class="hero">
    <h1>PCI security standards,<br>mapped and sourced.</h1>
    <p class="lead">
      An independent, citeable reference to the PCI standards landscape.
      Every current standard, its version history, status, supporting documents, and sunset dates,
      sourced to official PCI SSC publications.
    </p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-n">{standards.length}</span>
        <span class="stat-label">standards tracked</span>
      </div>
      <div class="stat">
        <span class="stat-n">{activeCount}</span>
        <span class="stat-label">currently active</span>
      </div>
      <div class="stat">
        <span class="stat-n">{sunsetCount}</span>
        <span class="stat-label">sunset scheduled</span>
      </div>
      <div class="stat">
        <span class="stat-n">{totalDocs}</span>
        <span class="stat-label">sourced documents</span>
      </div>
    </div>
    {lastVerified && (
      <p class="hero-verified">
        Data verified against PCI SSC as of{' '}
        <time datetime={lastVerified.toISOString()}>
          {lastVerified.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>.
      </p>
    )}
  </div>

  <!-- Standards list -->
  <section class="standards-section" aria-label="Standards list">
    <div class="section-header">
      <h2>Standards</h2>
      <a href="/timeline" class="section-action">Timeline view</a>
    </div>
    <div class="standards-list" role="list">
      {standards.map(entry => (
        <a
          href={`/standard/${entry.id}`}
          class="standard-row"
          role="listitem"
          aria-label={`${entry.data.name}, status: ${statusLabel[entry.data.status]}`}
        >
          <div class="row-body">
            <span class="row-name">{entry.data.name}</span>
            <div class="row-meta">
              <span class="status-badge" data-status={entry.data.status}>
                {statusLabel[entry.data.status]}
              </span>
              {entry.data.current_version && (
                <span class="version-chip">v{entry.data.current_version}</span>
              )}
              {!entry.data.verified && (
                <span class="provisional-chip">provisional</span>
              )}
            </div>
          </div>
          <svg class="row-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Framework filter bar */
  .framework-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .framework-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .framework-chips {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .framework-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    user-select: none;
  }

  .framework-chip--active {
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-accent);
  }

  .framework-chip--soon {
    opacity: 0.55;
  }

  .soon-badge {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Hero */
  .hero {
    padding-block: var(--space-12) var(--space-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 44rem;
    margin-bottom: var(--space-6);
    line-height: 1.65;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-n {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .hero-verified {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  /* Standards list */
  .standards-section { margin-top: 0; }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .section-header h2 { margin-bottom: 0; }

  .section-action {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--easing);
  }

  .section-action:hover { color: var(--color-accent); }

  .standards-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .standard-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-subtle);
    transition:
      border-color var(--duration-fast) var(--easing),
      background var(--duration-fast) var(--easing),
      transform var(--duration-fast) var(--easing);
  }

  .standard-row:hover {
    border-color: var(--color-accent);
    background: var(--color-bg);
    transform: translateY(-1px);
  }

  .row-body {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    min-width: 0;
  }

  .row-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .provisional-chip {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-under-review);
    padding: 0.125rem 0.375rem;
    border: 1px solid color-mix(in srgb, var(--color-under-review) 30%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-under-review) 8%, transparent);
  }

  .row-arrow {
    color: var(--color-border-strong);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--easing), transform var(--duration-fast) var(--easing);
  }

  .standard-row:hover .row-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  @media (max-width: 480px) {
    .row-name { font-size: 0.9375rem; }
    .hero h1 { font-size: 1.625rem; }
    .hero-stats { gap: var(--space-4); }
    .stat-n { font-size: 1.5rem; }
  }
</style>
